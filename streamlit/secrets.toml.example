# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is already in .gitignore and must never be committed.

DATABASE_URL = "postgresql://user:password@host:5432/ptms"
SECRET_KEY = "replace-with-a-long-random-value"

DEFAULT_ADMIN_EMAIL = "your-admin@example.com"
DEFAULT_ADMIN_PASSWORD = "a-strong-password-changed-immediately-after-first-login"

SESSION_TIMEOUT_MINUTES = "60"
MAX_FAILED_LOGIN_ATTEMPTS = "5"
ACCOUNT_LOCK_MINUTES = "15"
MIN_PASSWORD_LENGTH = "8"

ENVIRONMENT = "production"
